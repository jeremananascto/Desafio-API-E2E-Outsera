{
  "name": "we-do-it-qa-automation",
  "version": "1.0.0",
  "description": "Suíte de automação de testes: API (Playwright), E2E (Cucumber + Playwright) e CI/CD (GitHub Actions)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"{src,tests,features,pages}/**/*.ts\"",
    "install:browsers": "playwright install chromium",
    "test": "npm run test:api && npm run test:e2e",
    "test:api": "playwright test",
    "test:api:smoke": "playwright test --grep @smoke",
    "test:api:negative": "playwright test --grep @negative",
    "report:api": "playwright show-report reports/api/html",
    "test:e2e": "cucumber-js",
    "test:e2e:smoke": "cucumber-js -p smoke",
    "test:e2e:negative": "cucumber-js -p negative",
    "test:e2e:dry": "cucumber-js --dry-run --format summary",
    "report:e2e": "node scripts/generate-e2e-report.js",
    "demo-app": "node demo-app/server.js",
    "summary": "node scripts/ci-summary.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "dotenv": "^18.0.6",
    "eslint": "^10.12.0",
    "multiple-cucumber-html-reporter": "^4.4.2",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "zod": "^4.6.5"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
